{
  "name": "trakt.tv-mcp",
  "version": "1.0.0",
  "description": "MCP server for Trakt.tv API - enables AI assistants to track watched shows, movies, and anime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "husky install",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \".claude/**/*.ts\" \".husky/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run format && npm run build && npm run lint && npm test",
    "bulk-import": "tsx scripts/bulk-import.ts",
    "security:check": "tsx scripts/security-check.ts"
  },
  "keywords": [
    "mcp",
    "trakt",
    "trakt.tv",
    "watch-tracker",
    "tv-shows",
    "movies",
    "anime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "axios": "^1.13.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "langfuse": "^3.38.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/csv-parse": "^1.1.12",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/ui": "^3.2.4",
    "chalk": "^5.6.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "ora": "^8.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.4.0"
  }
}
