{
  "name": "trakt.tv-mcp",
  "version": "1.0.0",
  "description": "MCP server for Trakt.tv API - enables AI assistants to track watched shows, movies, and anime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "logwatch": "dist/bin/logwatch.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kofifort/trakt.tv-mcp.git"
  },
  "homepage": "https://github.com/kofifort/trakt.tv-mcp#readme",
  "bugs": {
    "url": "https://github.com/kofifort/trakt.tv-mcp/issues"
  },
  "scripts": {
    "preinstall": "node scripts/dev/check-node-version.js",
    "prepare": "husky install",
    "build": "node scripts/dev/build-wrapper.js",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \".claude/**/*.ts\" \".husky/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "E2E_TESTS_ENABLED=true vitest run tests/e2e",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run format && npm run build && npm run lint && npm test",
    "bulk-import": "tsx scripts/data/bulk-import.ts",
    "security:check": "tsx scripts/ops/security-check.ts",
    "auth:trakt": "tsx scripts/dev/seed-trakt-token.ts"
  },
  "keywords": [
    "mcp",
    "trakt",
    "trakt.tv",
    "watch-tracker",
    "tv-shows",
    "movies",
    "anime"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "package.json",
    "README.md",
    "LICENSE",
    "docs/README.md",
    "docs/guides/**/*.md",
    "docs/operations/*.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "axios": "^1.13.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "langfuse": "^3.38.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/csv-parse": "^1.1.12",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "chalk": "^5.6.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "ora": "^9.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "yaml": "^2.4.0"
  }
}
