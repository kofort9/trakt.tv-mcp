#!/bin/sh

# Get the files that are being pushed
# Compare current branch with remote branch
REMOTE="$1"
URL="$2"

# Get current branch name
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Get the remote tracking branch
REMOTE_BRANCH=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)

# If no remote tracking branch, compare with main
if [ -z "$REMOTE_BRANCH" ]; then
  REMOTE_BRANCH="origin/main"
fi

# Get list of changed files between local and remote
CHANGED_FILES=$(git diff --name-only HEAD "$REMOTE_BRANCH" 2>/dev/null)

# If we can't determine changed files, run tests to be safe
if [ -z "$CHANGED_FILES" ]; then
  echo "⚠️  Could not determine changed files, running tests to be safe..."
  npm test || exit 1
  echo "✅ All tests passed! Proceeding with push..."
  exit 0
fi

# Check if only documentation/config files changed
# Documentation: *.md, .claude/agents/*, docs/*
# Config: *.json (package.json excluded), *.yaml, *.yml
NON_DOC_CHANGES=$(echo "$CHANGED_FILES" | grep -v -E '\.(md)$' | grep -v -E '^\.claude/agents/' | grep -v -E '^docs/')

if [ -z "$NON_DOC_CHANGES" ]; then
  echo "📝 Only documentation files changed, skipping tests..."
  echo ""
  echo "$CHANGED_FILES" | sed 's/^/  - /'
  echo ""
  echo "✅ Documentation-only change, proceeding with push..."
  exit 0
fi

# Code files changed, run tests
echo "🧪 Running tests before push..."
echo ""

npm test || exit 1

echo ""
echo "✅ All tests passed! Proceeding with push..."
