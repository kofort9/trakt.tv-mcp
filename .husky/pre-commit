#!/bin/sh
# Pre-commit hook: Run code style checks before commit

# Load nvm if available (needed for correct Node version)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  \. "$NVM_DIR/nvm.sh"
else
  echo "⚠️  Warning: nvm not found at $NVM_DIR/nvm.sh"
  echo "   Ensure you're using Node 18.18+ or 20.x"
fi

# Verify Node version meets minimum requirements
NODE_VERSION=$(node -v 2>/dev/null | sed 's/v//')
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
if [ -n "$NODE_MAJOR" ] && [ "$NODE_MAJOR" -lt 18 ]; then
  echo "❌ Error: Node $NODE_VERSION detected. This project requires Node 18.18+ or 20.x"
  echo "   Run 'nvm use 18' or 'nvm use 20' to switch versions"
  exit 1
fi

echo "🔍 Running code style checks..."
echo ""

# Run prettier
echo "📝 Formatting code with Prettier..."
npm run format || exit 1

# Run ESLint
echo "🔎 Linting code with ESLint..."
npm run lint || exit 1

echo ""
echo "✅ Code style checks passed!"

