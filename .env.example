# Trakt.tv API Credentials
# Get your credentials at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_client_id_here
TRAKT_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI (for device flow, this can be urn:ietf:wg:oauth:2.0:oob)
TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# API Settings
TRAKT_API_VERSION=2
TRAKT_API_BASE_URL=https://api.trakt.tv

# Privacy Settings (public or private)
DEFAULT_PRIVACY=private

# Langfuse Observability Configuration (Optional)
# Langfuse provides observability for NLP ambiguity detection and tool usage
# Get your credentials from https://cloud.langfuse.com (or your self-hosted instance)
# Telemetry is automatically enabled if LANGFUSE_SECRET_KEY and LANGFUSE_PUBLIC_KEY are present
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # Optional: defaults to Langfuse Cloud
# LANGFUSE_ENABLED=true  # Optional: defaults to true if keys are present
